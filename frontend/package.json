{
  "name": "carsharing-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint:css": "stylelint \"src/**/*.css\"",
    "build": "npm run typecheck && npm run lint:css && vite build"
  },
  "dependencies": {
    "carsharing-workspace": "file:..",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "36.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
