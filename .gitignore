# Local planning documents stay outside Git, including all nested files.
/docs/
/CONTRIBUTING.md
/.scratch/

# Local configuration and credentials. Only explicit examples are versioned.
.env
.env.*
!.env.example
!.env.*.example
*.local
secrets/
.secrets/
credentials/
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa*
id_ed25519*
.npmrc
.netrc

# Databases, backups, runtime data and logs (SQL migrations remain trackable).
*.db
*.db-*
*.sqlite
*.sqlite3
*.dump
*.backup
*.sql.gz
*.sql.zip
dumps/
backups/
data/
volumes/
logs/
*.log
*.pid

# The map's basemap: built during an image build from the declaration in the frontend, and far too
# large to carry in history. The archive alone is tens of megabytes.
frontend/public/basemap/

# Go, frontend dependencies, generated builds and test output.
bin/
dist/
build/
node_modules/
vendor/
*.exe
*.test
*.prof
coverage/
coverage.out
coverage.xml
*.tsbuildinfo
test-results/
playwright-report/
blob-report/
.cache/
.npm-cache/
.tools/
tmp/
temp/

# Machine-specific editor and OS files.
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# The build cache of a local Go run is machine state, not a source of the repository.
.gocache/
