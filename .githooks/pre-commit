#!/bin/sh
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if command -v node >/dev/null 2>&1 && [ -f node_modules/prettier/bin/prettier.cjs ]; then
  node scripts/format-staged.mjs
else
  echo 'Skipping formatting: install dependencies with npm ci at the repository root' >&2
fi

exec /bin/sh scripts/check-secrets.sh staged
